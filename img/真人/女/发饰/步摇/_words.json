{
  "词条": "步摇",
  "英文": "buyao (dangling hairpin)",
  "一句话": "带垂坠的簪子，走路会晃——古装里“动起来好看”的关键配件。",
  "结构": [
    "簪身：细长，插入发团",
    "垂挂：1–5 串珠链或流苏",
    "长度：垂到耳下或肩头",
    "材质：金、银、玉，配珍珠与红玛瑙"
  ],
  "易错": [
    "AI 会把垂链画成直线，没有摆动感",
    "垂坠过长会挡住脸，实际到耳下为准",
    "多串步摇同时出现会显乱，一般单侧一支"
  ],
  "风格": [
    "古风",
    "灵动"
  ],
